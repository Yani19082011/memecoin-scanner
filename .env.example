# Копирай на .env локално. На Render тези отиват в "Environment" таба на service-а.

# --- PumpPortal (безплатен public data feed, без ключ за миграция/graduation събития) ---
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# --- Реално-времево следене (вместо еднократна проверка след фиксирано изчакване) ---
INITIAL_INDEX_DELAY_SECONDS=90
POLL_INTERVAL_SECONDS=60
MONITOR_WINDOW_MINUTES=45

# --- Прагове за скоринга (виж scoring.py) ---
MIN_LIQUIDITY_USD=5000
HIGH_POTENTIAL_THRESHOLD=65

# --- Email алърти през Resend (https://resend.com), НЕ Gmail SMTP ---
# Регистрирай се безплатно с yani.kolev2011@gmail.com -> Dashboard -> "API Keys" -> Create.
ALERT_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ALERT_EMAIL_TO=yani.kolev2011@gmail.com

# --- Anti-spam темпо за Resend (безплатен tier = 100 имейла/ден за целия акаунт,
# споделен между двата бота: 90 тук за memecoin, 10 за penny-stock-scanner) -
# по подразбиране 1 имейл на 5 мин (макс ~2/10мин). ---
MIN_EMAIL_INTERVAL_SECONDS=300
MAX_EMAILS_PER_DAY=90

# --- "Тихи часове" за имейл алъртите - само между тези часове местно време
# (по подразбиране 07:30-23:00 Europe/Sofia). Особено важно тук, защото
# memecoin ботът следи pump.fun 24/7. Алъртите пак се логват в Render Logs
# денонощно - само самото изпращане на email се пропуска. ---
ALERT_QUIET_HOURS_TZ=Europe/Sofia
ALERT_ACTIVE_START_HOUR=7
ALERT_ACTIVE_START_MINUTE=30
ALERT_ACTIVE_END_HOUR=23
ALERT_ACTIVE_END_MINUTE=0

# --- Impersonation филтър - пропуска монети кръстени на известни хора
# (Elon Musk, Trump и т.н.), защото почти никога не са реално техни - виж
# коментара в config.py. НЕ слагай тази променлива изобщо, ако искаш
# default списъка - ако я зададеш (дори празна), заменя го изцяло. ---
# IMPERSONATION_KEYWORDS=elon,musk,trump,biden,...

# --- Render port ---
PORT=10000
